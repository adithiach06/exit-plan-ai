# ==========================================
# EXIT PLAN AI - Environment Configuration
# ==========================================
# Copy this file to `.env` if you wish to configure optional environment variables.
# Note: EXIT PLAN AI is fully functional as a standalone client-side application.
# No .env file, external API keys, or backend server are required to run the app.
# NEVER commit a real `.env` file containing actual secrets or sensitive credentials.

# Optional: Google Maps API Key
# (Leaflet and OpenStreetMap are used by default; external key is not required for normal operation)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Backend AI Gateway URL
# Note: No backend server is included in this repository and none is required.
# All core features (Travel Advisor, Scam Shield, Safe Havens, Safety Vault, SOS)
# operate 100% client-side in the browser using built-in offline engines.
# This variable is an optional architectural placeholder for future proxy integrations.
# Developers do NOT need to run localhost:5000.
VITE_AI_BACKEND_URL=
